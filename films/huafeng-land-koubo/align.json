 "sentences": [
  {
   "text": "鳳山華鳳特區，難得釋出的美建地！",
   "start": 0.25,
   "end": 3.829,
   "keys": {}
  },
  {
   "text": "基地兩百九十五坪，北臨鎮北北巷，面寬三十四點七米，南接文龍東路，雙面臨路。",
   "start": 4.133,
   "end": 12.878,
   "keys": {
    "雙面臨路": [
     11.814,
     12.878
    ]
   }
  },
  {
   "text": "住三之一，建蔽六成，容積百分之兩百四十，好排電梯店住。",
   "start": 13.178,
   "end": 19.75,
   "keys": {}
  },
  {
   "text": "文龍東路餐飲咖啡林立，生活機能成熟。",
   "start": 20.052,
   "end": 24.232,
   "keys": {}
  },
  {
   "text": "文山華鳳雙特區交界，還有捷運黃線延伸題材。",
   "start": 24.534,
   "end": 29.435,
   "keys": {}
  },
  {
   "text": "單價每坪五十萬，總價約一點四八億。",
   "start": 29.763,
   "end": 33.479,
   "keys": {
    "五十萬": [
     30.61,
     31.246
    ]
   }
  },
  {
   "text": "永慶不動產大順鴻麗店，陳庭妍，歡迎來電。",
   "start": 33.785,
   "end": 38.501,
   "keys": {}
  }
 ]
